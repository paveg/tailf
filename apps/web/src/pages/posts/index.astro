---
import Layout from '../../layouts/Layout.astro'
import { PostList } from '../../components/PostList'
import { fetchFirstPostsPageForSSG } from '../../lib/server-api'

const initialPage = await fetchFirstPostsPageForSSG()
---

<Layout title="記事一覧" description="日本の技術ブログの記事一覧">
	<div class="container mx-auto px-4 py-8">
		<h1 class="mb-8 text-3xl font-bold">記事一覧</h1>
		<PostList client:load initialPage={initialPage} />
	</div>
</Layout>
